/* QSS Style Sheet - LOOPIEST KeyFinder Dark/Neon Purple Theme */

#MainContainer {
    background-color: #0A0A0E;
    border: 1px solid #2D0B5A;
    border-radius: 16px;
}

/* Header & Action Buttons */
#HeaderTag {
    color: #8A2BE2;
    font-size: 11px;
    font-weight: bold;
    letter-spacing: 2px;
    font-family: 'Segoe UI', Arial, sans-serif;
}

#HeaderTag a {
    color: #8A2BE2;
    text-decoration: none;
    font-weight: bold;
}

#HeaderTag a:hover {
    color: #B066FE;
    text-decoration: underline;
}

#CloseButton {
    background-color: transparent;
    color: #8E8EA0;
    font-size: 14px;
    font-weight: bold;
    font-family: 'Segoe UI', Arial, sans-serif;
    border: none;
    border-radius: 12px;
    padding: 0px;
}

#CloseButton:hover {
    background-color: #8A2BE2;
    color: #FFFFFF;
}

#CloseButton:pressed {
    background-color: #2D0B5A;
    color: #E0E0E0;
}

/* App Title / Subtitle */
#AppTitle {
    color: #FFFFFF;
    font-size: 20px;
    font-weight: 700;
    letter-spacing: 2px;
    font-family: 'Segoe UI', sans-serif;
}

#AppSubtitle {
    color: #8A2BE2;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 3px;
    font-family: 'Segoe UI', sans-serif;
}

/* Status & Progress Labels */
#StatusLabel {
    color: #A0A0B8;
    font-size: 12px;
    font-family: 'Segoe UI', sans-serif;
}

#PercentageLabel {
    color: #8A2BE2;
    font-size: 13px;
    font-weight: bold;
    font-family: 'Segoe UI', sans-serif;
}

/* Progress Bar */
QProgressBar {
    background-color: #14141E;
    border: 1px solid #23123B;
    border-radius: 6px;
    text-align: center;
}

QProgressBar::chunk {
    background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:0, stop:0 #4A00E0, stop:0.5 #8A2BE2, stop:1 #B066FE);
    border-radius: 5px;
}

/* Start Button in Splash Screen */
#StartButton {
    background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:0, stop:0 #2D0B5A, stop:1 #8A2BE2);
    color: #FFFFFF;
    font-size: 14px;
    font-weight: bold;
    letter-spacing: 2px;
    font-family: 'Segoe UI', sans-serif;
    border: 1px solid #8A2BE2;
    border-radius: 10px;
    padding: 10px 20px;
}

#StartButton:hover {
    background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:0, stop:0 #8A2BE2, stop:1 #A044FE);
    border: 1px solid #FFFFFF;
}

#StartButton:pressed {
    background-color: #2D0B5A;
}

/* Drag & Drop Zone Component */
#DropZone {
    background-color: #111118;
    border: 2px dashed #4A1584;
    border-radius: 14px;
}

#DropZone:hover {
    background-color: #161424;
    border: 2px dashed #8A2BE2;
}

#DropZoneActive {
    background-color: #221538;
    border: 2px dashed #B066FE;
}

#DropZoneIcon {
    font-size: 38px;
    color: #8A2BE2;
}

#DropZoneTitle {
    color: #FFFFFF;
    font-size: 14px;
    font-weight: 600;
    font-family: 'Segoe UI', sans-serif;
}

#DropZoneSubtitle {
    color: #7E7E98;
    font-size: 11px;
    font-family: 'Segoe UI', sans-serif;
}

/* Error Alert Box */
#ErrorAlertBox {
    background-color: #2D0A14;
    border: 1px solid #EF4444;
    border-radius: 10px;
    color: #FCA5A5;
    font-size: 12px;
    font-weight: bold;
    padding: 10px 14px;
    font-family: 'Segoe UI', sans-serif;
}

/* Results Page Components */
#KeyHighlightCard {
    background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:1, stop:0 #180B2D, stop:1 #0F0A1E);
    border: 2px solid #8A2BE2;
    border-radius: 14px;
    padding: 16px;
}

#KeyTextHighlight {
    color: #8A2BE2;
    font-size: 26px;
    font-weight: 800;
    letter-spacing: 1px;
    font-family: 'Segoe UI', sans-serif;
}

#RelativeKeyLabel {
    color: #B066FE;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 1px;
    font-family: 'Segoe UI', sans-serif;
    background-color: #170F28;
    border: 1px solid #3B166A;
    border-radius: 8px;
    padding: 6px 12px;
}

#BpmLabel {
    color: #FFFFFF;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 1px;
    font-family: 'Segoe UI', sans-serif;
}

#TuningLabel {
    color: #C084FC;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 1px;
    font-family: 'Segoe UI', sans-serif;
}

#RenameButton {
    background-color: #170F28;
    color: #B066FE;
    border: 1px solid #3B166A;
    border-radius: 8px;
    padding: 10px 20px;
    font-size: 13px;
    font-weight: 700;
    font-family: 'Segoe UI', sans-serif;
    min-width: 240px;
}

#RenameButton:hover {
    background-color: #2D0B5A;
    color: #FFFFFF;
    border-color: #8A2BE2;
}

#RenameButton:disabled {
    background-color: #120C1F;
    color: #00E676;
    border-color: #1E3A29;
}

QMenu {
    background-color: #120C1F;
    color: #FFFFFF;
    border: 1px solid #3B166A;
    border-radius: 8px;
    padding: 6px;
}

QMenu::item {
    padding: 8px 18px;
    border-radius: 4px;
    font-family: 'Segoe UI', sans-serif;
    font-size: 12px;
    color: #E0E0F0;
}

QMenu::item:selected {
    background-color: #2D0B5A;
    color: #B066FE;
}

#KeySubtext {
    color: #A0A0B8;
    font-size: 12px;
    font-family: 'Segoe UI', sans-serif;
}

#SectionTitle {
    color: #FFFFFF;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 1px;
    font-family: 'Segoe UI', sans-serif;
}

#AudioMetadataBox {
    background-color: #12121A;
    border: 1px solid #23123B;
    border-radius: 10px;
    padding: 8px 12px;
    color: #8E8EA0;
    font-size: 11px;
    font-family: 'Segoe UI', sans-serif;
}

#NoteRowLabel {
    color: #FFFFFF;
    font-size: 12px;
    font-weight: bold;
    font-family: 'Segoe UI', sans-serif;
}

#NoteRowPct {
    color: #8A2BE2;
    font-size: 12px;
    font-weight: bold;
    font-family: 'Segoe UI', sans-serif;
}

/* ==============================================================================
   Login & Passkey Screen Styles
   ============================================================================== */

#PasskeyInput {
    background-color: #12121C;
    border: 1px solid #3B166A;
    border-radius: 10px;
    color: #FFFFFF;
    font-size: 13px;
    font-family: 'Consolas', 'Courier New', monospace;
    font-weight: 700;
    letter-spacing: 2px;
    padding: 10px 14px;
    selection-background-color: #8A2BE2;
}

#PasskeyInput:focus {
    border: 1px solid #8A2BE2;
    background-color: #161326;
}

#UsernameInput {
    background-color: #12121C;
    border: 1px solid #3B166A;
    border-radius: 10px;
    color: #FFFFFF;
    font-size: 13px;
    font-family: 'Segoe UI', Arial, sans-serif;
    font-weight: 600;
    padding: 10px 14px;
    selection-background-color: #8A2BE2;
}

#UsernameInput:focus {
    border: 1px solid #8A2BE2;
    background-color: #161326;
}

#PasteButton {
    background-color: #1A112E;
    color: #B066FE;
    border: 1px solid #3B166A;
    border-radius: 8px;
    padding: 8px 14px;
    font-size: 11px;
    font-weight: 700;
    font-family: 'Segoe UI', sans-serif;
    letter-spacing: 1px;
}

#PasteButton:hover {
    background-color: #8A2BE2;
    color: #FFFFFF;
    border-color: #A044FE;
}

#PasteButton:pressed {
    background-color: #2D0B5A;
}

#VerificationCard {
    background-color: #0E0E16;
    border: 1px solid #23123B;
    border-radius: 12px;
    padding: 10px 14px;
}

#VerificationTitle {
    color: #8A2BE2;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 2px;
    font-family: 'Segoe UI', sans-serif;
}

#CheckItemActive {
    color: #00E676;
    font-size: 11px;
    font-weight: 600;
    font-family: 'Segoe UI', sans-serif;
}

#CheckItemInactive {
    color: #55556E;
    font-size: 11px;
    font-weight: 500;
    font-family: 'Segoe UI', sans-serif;
}

#SuccessAlertBox {
    background-color: #0B291A;
    border: 1px solid #00E676;
    border-radius: 10px;
    color: #A7F3D0;
    font-size: 12px;
    font-weight: bold;
    padding: 10px 14px;
    font-family: 'Segoe UI', sans-serif;
}

QCheckBox {
    color: #A0A0B8;
    font-size: 11px;
    font-family: 'Segoe UI', sans-serif;
    spacing: 8px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #3B166A;
    border-radius: 4px;
    background-color: #14141E;
}

QCheckBox::indicator:checked {
    background-color: #8A2BE2;
    border-color: #B066FE;
}

QCheckBox::indicator:hover {
    border-color: #8A2BE2;
}

/* ==============================================================================
   Software Hub & Disc Cards Styles
   ============================================================================== */

#HubUserChip {
    background-color: #120C1F;
    border: 1px solid #2D0B5A;
    border-radius: 8px;
    color: #E2E8F0;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
    padding: 5px 12px;
    font-family: 'Segoe UI', sans-serif;
}

#HubCard {
    background-color: #0F0F16;
    border: 1px solid #281242;
    border-radius: 16px;
    padding: 4px;
}

#HubCard:hover {
    background-color: #141124;
    border: 1px solid #8A2BE2;
}

#HubCardLocked {
    background-color: #0B0B10;
    border: 1px solid #1C152B;
    border-radius: 16px;
    padding: 4px;
}

#HubCardLocked:hover {
    background-color: #0F0D18;
    border: 1px solid #3B166A;
}

#BadgeAvailable {
    background-color: #0D261A;
    color: #00E676;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 1.5px;
    font-family: 'Segoe UI', sans-serif;
    border: 1px solid #14532D;
    border-radius: 10px;
    padding: 3px 10px;
    max-height: 20px;
}

#BadgeLocked {
    background-color: #170F28;
    color: #8A7A9E;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 1.5px;
    font-family: 'Segoe UI', sans-serif;
    border: 1px solid #2D1B4D;
    border-radius: 10px;
    padding: 3px 10px;
    max-height: 20px;
}

#HubCardCategory {
    color: #8A2BE2;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1.5px;
    font-family: 'Segoe UI', sans-serif;
}

#HubCardTitle {
    color: #FFFFFF;
    font-size: 14px;
    font-weight: 800;
    letter-spacing: 1px;
    font-family: 'Segoe UI', sans-serif;
}

#HubCardDesc {
    color: #8E8EA0;
    font-size: 11px;
    font-family: 'Segoe UI', sans-serif;
    line-height: 1.3;
}

#HubDisabledButton {
    background-color: #14111D;
    color: #5C5C70;
    font-size: 12px;
    font-weight: bold;
    letter-spacing: 1.5px;
    font-family: 'Segoe UI', sans-serif;
    border: 1px solid #231A33;
    border-radius: 10px;
    padding: 8px 16px;
}

#HubDisabledButton:hover {
    background-color: #1A1326;
    color: #8E8EA0;
    border-color: #3B166A;
}

#HubToast {
    background-color: #1B0F2E;
    border: 1px solid #8A2BE2;
    border-radius: 10px;
    color: #D8B4FE;
    font-size: 12px;
    font-weight: 600;
    padding: 8px 14px;
    font-family: 'Segoe UI', sans-serif;
}

#HubReturnButton {
    background-color: #140E26;
    color: #B066FE;
    border: 1px solid #3B166A;
    border-radius: 8px;
    padding: 4px 10px;
    font-size: 11px;
    font-weight: bold;
    font-family: 'Segoe UI', sans-serif;
    letter-spacing: 1px;
}

#HubReturnButton:hover {
    background-color: #8A2BE2;
    color: #FFFFFF;
    border-color: #B066FE;
}


